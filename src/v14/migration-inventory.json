{
  "schema": "atelier-v14-migration-inventory-v1",
  "version": "14.0.0-dev.13",
  "policy": {
    "phase": "stabilization",
    "excludedByDefault": [
      "project-persistence",
      "project-schema",
      "geometry",
      "rendering"
    ],
    "selectionRequired": false,
    "selectionRules": {
      "requiredStateRisk": "low",
      "requiredTestability": "high",
      "maxBrowserCoupling": "low",
      "requiresLegacyFallback": true
    },
    "stabilization": {
      "architectureFrozen": true,
      "allowNewLegacyBridges": false,
      "allowProductionCutover": false,
      "frozenModules": [
        "shell/notifications.js",
        "shell/dialogs.js",
        "shell/commands.js",
        "shell/files.js",
        "shell/icons.js",
        "shell/text.js",
        "shell/units.js",
        "dev-status/dev-status.js"
      ],
      "frozenPatches": [
        "patches/notifications-bridge.json",
        "patches/dialogs-bridge.json",
        "patches/commands-bridge.json",
        "patches/files-bridge.json",
        "patches/icons-bridge.json",
        "patches/text-bridge.json",
        "patches/units-bridge.json"
      ]
    }
  },
  "boundaries": [
    {
      "id": "dimension-formatting",
      "legacyArea": "plan2d",
      "symbols": ["fmtDim"],
      "ownership": "presentation-formatting",
      "stateRisk": "low",
      "mutationRisk": "none",
      "callSurface": "localized",
      "browserCoupling": "none",
      "testability": "high",
      "userPayoff": "medium",
      "decision": "completed",
      "targetMilestone": "14.0.0-dev.12",
      "rationale": "Pure deterministic unit formatting was migrated behind an exact fallback bridge in dev.12. The legacy helper body remains available if the V14 units service is unavailable."
    },
    {
      "id": "icon-registry-data",
      "legacyArea": "icons",
      "symbols": ["ICON_PATHS"],
      "ownership": "presentation-data",
      "stateRisk": "low",
      "mutationRisk": "none",
      "callSurface": "broad-readonly",
      "browserCoupling": "none",
      "testability": "high",
      "userPayoff": "low",
      "decision": "hold",
      "targetMilestone": null,
      "rationale": "The renderer is already modular. Moving a large immutable path table would add churn without meaningful behavioral or user-facing benefit."
    },
    {
      "id": "project-model-utility-math",
      "legacyArea": "project-model",
      "symbols": ["clone", "clamp", "round", "rad"],
      "ownership": "project-and-geometry-utility",
      "stateRisk": "medium",
      "mutationRisk": "indirect",
      "callSurface": "broad",
      "browserCoupling": "none",
      "testability": "high",
      "userPayoff": "low",
      "decision": "defer",
      "targetMilestone": null,
      "rationale": "Individually pure helpers are deeply shared across project and geometry code. Extraction would enlarge the dependency surface for little payoff."
    },
    {
      "id": "identity-generation",
      "legacyArea": "project-model",
      "symbols": ["uid"],
      "ownership": "project-identity",
      "stateRisk": "medium",
      "mutationRisk": "indirect",
      "callSurface": "broad",
      "browserCoupling": "low",
      "testability": "medium",
      "userPayoff": "low",
      "decision": "defer",
      "targetMilestone": null,
      "rationale": "Object identity participates in project integrity and collision behavior. It is not an appropriate extraction merely for modularity."
    },
    {
      "id": "keyboard-action-dispatch",
      "legacyArea": "app-orchestration",
      "symbols": ["keyboard handlers", "data-action dispatcher", "data-command dispatcher"],
      "ownership": "application-orchestration",
      "stateRisk": "high",
      "mutationRisk": "direct",
      "callSurface": "broad",
      "browserCoupling": "high",
      "testability": "medium",
      "userPayoff": "medium",
      "decision": "defer",
      "targetMilestone": null,
      "rationale": "Dispatch owns broad application mutation paths. Current exact bridges intentionally preserve this legacy execution boundary."
    },
    {
      "id": "catalog-state",
      "legacyArea": "catalog",
      "symbols": ["CATALOG", "catalog filters", "collections", "recent items"],
      "ownership": "catalog-application-state",
      "stateRisk": "high",
      "mutationRisk": "direct",
      "callSurface": "broad",
      "browserCoupling": "medium",
      "testability": "medium",
      "userPayoff": "medium",
      "decision": "defer",
      "targetMilestone": null,
      "rationale": "Command-palette presentation can consume catalog data without relocating catalog ownership. Moving state now would exceed the shell migration boundary."
    },
    {
      "id": "project-persistence",
      "legacyArea": "storage",
      "symbols": ["save", "autosave", "durable storage", "project library"],
      "ownership": "project-persistence",
      "stateRisk": "critical",
      "mutationRisk": "direct",
      "callSurface": "broad",
      "browserCoupling": "high",
      "testability": "medium",
      "userPayoff": "high",
      "decision": "blocked",
      "targetMilestone": null,
      "rationale": "Persistence is explicitly excluded from opportunistic V14 extraction because regressions can cause data loss."
    },
    {
      "id": "project-schema-validation",
      "legacyArea": "project-model",
      "symbols": ["VERSION", "validateProject", "normalization"],
      "ownership": "project-schema",
      "stateRisk": "critical",
      "mutationRisk": "direct",
      "callSurface": "broad",
      "browserCoupling": "none",
      "testability": "high",
      "userPayoff": "high",
      "decision": "blocked",
      "targetMilestone": null,
      "rationale": "Project compatibility remains V1-V10 -> V10. Schema migration requires its own explicit release project rather than incidental modularization."
    },
    {
      "id": "geometry-precision",
      "legacyArea": "geometry-and-precision",
      "symbols": ["spatial tools", "geometry", "precision"],
      "ownership": "geometry",
      "stateRisk": "critical",
      "mutationRisk": "direct",
      "callSurface": "broad",
      "browserCoupling": "low",
      "testability": "medium",
      "userPayoff": "high",
      "decision": "blocked",
      "targetMilestone": null,
      "rationale": "Geometry correctness is core project behavior and explicitly outside the low-risk shell/helper extraction program."
    },
    {
      "id": "plan2d-renderer",
      "legacyArea": "plan2d",
      "symbols": ["symbol2D", "2D plan render path"],
      "ownership": "rendering",
      "stateRisk": "high",
      "mutationRisk": "indirect",
      "callSurface": "broad",
      "browserCoupling": "medium",
      "testability": "medium",
      "userPayoff": "high",
      "decision": "blocked",
      "targetMilestone": null,
      "rationale": "The renderer is excluded by default. Pure formatting helpers may be extracted around it without moving renderer ownership."
    },
    {
      "id": "scene3d-renderer",
      "legacyArea": "3d-scene",
      "symbols": ["3D scene", "WebGL render path", "3D interaction"],
      "ownership": "rendering",
      "stateRisk": "critical",
      "mutationRisk": "direct",
      "callSurface": "broad",
      "browserCoupling": "high",
      "testability": "medium",
      "userPayoff": "high",
      "decision": "blocked",
      "targetMilestone": null,
      "rationale": "3D isolation and safe-mode recovery are production-critical. Renderer extraction requires a dedicated architecture effort."
    },
    {
      "id": "exchange-export-orchestration",
      "legacyArea": "exports-and-exchange",
      "symbols": ["backup export", "deliverable export", "exchange serialization"],
      "ownership": "project-exchange",
      "stateRisk": "high",
      "mutationRisk": "indirect",
      "callSurface": "broad",
      "browserCoupling": "medium",
      "testability": "high",
      "userPayoff": "high",
      "decision": "defer",
      "targetMilestone": null,
      "rationale": "Generic browser download delivery is already modular. Domain serialization/export semantics remain legacy-owned because they are coupled to project compatibility."
    }
  ]
}
